---
// The shell of every page. Two kinds:
// - 'app' pages (Home, Explore, Profile, About) have the header with the streak and
//   points counters, a footer, and the tab bar along the bottom.
// - 'bare' pages (a course's book page and its reader) fill the screen like an
//   open book, and draw their own top bar with a way back.
import '@fontsource-variable/lexend';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import SettingsDialog from '../components/SettingsDialog.astro';
import TabBar, { type Tab } from '../components/TabBar.astro';
import Catalogue from '../components/Catalogue.astro';
import Footer from '../components/Footer.astro';
import Splash from '../components/Splash.astro';
import { SITE_NAME, DESCRIPTION } from '../lib/site';
import { href, absolute } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** The page's own path, e.g. '/explore/', used for the canonical and share URLs. */
  path: string;
  chrome?: 'app' | 'bare';
  /** On 'app' pages, which tab to mark as the current one. */
  tab?: Tab;
}

const { title, description = DESCRIPTION, path, chrome = 'app', tab } = Astro.props;
const pageTitle = path === '/' ? `${SITE_NAME}: practise the call before it counts` : `${title} | ${SITE_NAME}`;
const canonical = absolute(path);
---

<!doctype html>
<html lang="en-GB" data-size="md" data-space="normal" data-bg="auto" data-chrome={chrome}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b140f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Runs before the page paints, so saved reading settings never flash the default look. -->
    <script is:inline>
      try {
        var saved = JSON.parse(localStorage.getItem('gc-settings') || '{}');
        var allowed = {
          size: ['sm', 'md', 'lg'],
          space: ['normal', 'roomy'],
          bg: ['auto', 'soft', 'cream', 'dark'],
        };
        for (var key in allowed) {
          if (allowed[key].indexOf(saved[key]) > -1) {
            document.documentElement.setAttribute('data-' + key, saved[key]);
          }
        }
      } catch (e) {}
    </script>

    <!--
      The opening screen (src/components/Splash.astro), decided before the page paints:
      - shown when arriving from outside Good Call (another site, a link, a new tab),
        but not when moving between its own pages;
      - and always, with a question, until the visitor has told us their name.
      If this browser blocks storage, the name could never be saved, so it does not ask.
    -->
    <script is:inline define:vars={{ base: import.meta.env.BASE_URL.replace(/\/$/, '') }}>
      try {
        var profile = JSON.parse(localStorage.getItem('gc-profile') || '{}');
        var named = Boolean(profile.character && String(profile.character.name || '').trim());
        var inside = false;
        try {
          var from = new URL(document.referrer);
          inside = from.origin === location.origin && from.pathname.indexOf(base + '/') === 0;
        } catch (e) {}
        if (!inside || !named) document.documentElement.classList.add('splash-on');
        if (!named) document.documentElement.classList.add('splash-ask');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      chrome === 'app' ? (
        <div class="shell">
          <header class="appbar">
            <a class="wm-link" href={href('/')} aria-label="Good Call home">
              <Wordmark />
            </a>
            <div class="appbar-tools">
              <a class="chip chip-streak" href={href('/profile/#stats')} data-streak-chip>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.6 1.2 2.6 2.3 2.8C10.8 8.6 11.4 5.6 12 3z" />
                </svg>
                <span data-streak>0</span>
                <span class="visually-hidden">&nbsp;day streak</span>
              </a>
              <a class="chip chip-points" href={href('/profile/#points')}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="8" />
                  <path d="M12 8v8M9.5 10.2c0-1.2 1.1-2 2.5-2s2.5.8 2.5 1.9c0 2.6-5 1.5-5 4 0 1.1 1.1 1.9 2.5 1.9s2.5-.8 2.5-2" />
                </svg>
                <span data-points>0</span>
                <span class="visually-hidden">&nbsp;points</span>
              </a>
              <button type="button" class="iconbtn round" data-open-settings aria-haspopup="dialog" aria-label="Reading settings">
                Aa
              </button>
            </div>
          </header>
          <main id="main">
            <slot />
          </main>
          <Footer />
          <TabBar current={tab} />
        </div>
      ) : (
        <main id="main" class="bare">
          <slot />
        </main>
      )
    }
    <Splash />
    <div class="toasts" data-toasts aria-live="polite"></div>
    <SettingsDialog />
    <Catalogue />
    <script>
      import '../scripts/splash.ts';
      import '../scripts/settings.ts';
      import '../scripts/info.ts';
      import '../scripts/activity.ts';
    </script>
  </body>
</html>
