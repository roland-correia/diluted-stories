---
// A course on a shelf or in a grid: its cover and its name. Screen readers also hear
// how far the visitor has got, which src/scripts/books.ts fills in.
// Courses that are not live yet are shown greyed out, as "Coming soon", and do not link anywhere.
import BookCover from './BookCover.astro';
import { sets, type SetId } from '../lib/site';
import { courses } from '../lib/courses';
import { href } from '../lib/paths';

interface Props {
  id: SetId;
  /** Searchable words for the Explore tab, such as topic and scenario titles. */
  keywords?: string;
}

const { id, keywords } = Astro.props;
const set = sets[id];
const course = courses[id];
// Parenting courses keep their age range on its own line: 'The early weeks', then '0 to 3 months'.
const shortName = set.name.split(':')[0];
---

{
  set.live ? (
    <a class="book" href={href(`/courses/${id}/`)} data-book={id} data-category={course.category} data-keywords={keywords}>
      <BookCover id={id} decorative />
      <b>{shortName}</b>
      {course.cover.sub && <small>{course.cover.sub}</small>}
      <small class="visually-hidden" data-book-status />
    </a>
  ) : (
    <div class="book soon" data-book={id} data-category={course.category} data-keywords={keywords}>
      <BookCover id={id} decorative />
      <b>{set.name}</b>
      <small>Coming soon</small>
    </div>
  )
}
