---
// A module's notes (src/lib/lessons.ts), shown at the top of the first card of a
// topic in the reader: a content note with a link to the help list, the opener,
// the teaching, and one habit to practise this week. It folds away, so the
// question underneath is one tap away.
import type { Lesson } from '../lib/lessons';

interface Props {
  lesson: Lesson;
  /** The topic's name, e.g. "Ask, don't assume". */
  name: string;
}

const { lesson, name } = Astro.props;
---

<details class="lesson" open data-lesson>
  <summary>Module notes: {name}</summary>
  <div class="lesson-body">
    <p class="lesson-note">
      This module can bring up difficult things. Take it at your own pace, and{' '}
      <a href="#help" data-open-help>see where to get help</a> at any time.
    </p>
    {lesson.opener.map((line, i) => <p class:list={{ 'lesson-lead': i === 0 }}>{line}</p>)}

    {
      lesson.sections.map((section) => (
        <section class="lesson-section">
          <h3>{section.heading}</h3>
          {section.text && <p>{section.text}</p>}
          {section.table && (
            <div class:list={['lesson-table', { stacked: section.table.head.length > 2 }]}>
              <table>
                <thead>
                  <tr>
                    {section.table.head.map((cell) => (
                      <th scope="col">{cell}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, i) =>
                        i === 0 ? <th scope="row">{cell}</th> : <td data-label={section.table!.head[i]}>{cell}</td>,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {section.points &&
            (section.ordered ? (
              <ol class="lesson-points numbered">
                {section.points.map((point) => (
                  <li>
                    <b>{point.term}</b> {point.text}
                  </li>
                ))}
              </ol>
            ) : (
              <ul class="lesson-points">
                {section.points.map((point) => (
                  <li>
                    <b>{point.term}</b> {point.text}
                  </li>
                ))}
              </ul>
            ))}
          {section.items &&
            (section.ordered ? (
              <ol class="lesson-points numbered">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ol>
            ) : (
              <ul class="ticks">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ))}
          {section.after && <p>{section.after}</p>}
        </section>
      ))
    }

    <aside class="lesson-habit" aria-label="This week's habit">
      <p class="kicker">This week's habit</p>
      <p><b>{lesson.habit.name}.</b> {lesson.habit.text}</p>
    </aside>
  </div>
</details>
