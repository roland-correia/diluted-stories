---
// One scenario as a question: where it happens (an illustrated scene, or the
// conversation on a phone screen), the situation, the choices, and the reason for
// each. Used as a step in a course's reader, and on a scenario's own page.
// src/scripts/scenario.ts makes it work, src/scripts/scene.ts draws the scene with
// the visitor's own character in it, and src/scripts/cast.ts puts their name in
// the question.
import Scene from './Scene.astro';
import Chat from './Chat.astro';
import { slugOf, type Scenario } from '../lib/scenarios';
import { calls } from '../lib/site';
import { sceneFor } from '../lib/scene-map';

interface Props {
  entry: Scenario;
  /** The small line above the title, such as the module's name. */
  label: string;
  /** 'page' when the scenario has a page to itself, so its title is the page heading. */
  as?: 'page' | 'card';
}

const { entry, label, as = 'card' } = Astro.props;
const scenario = entry.data;
const slug = slugOf(entry);
const paragraphs = scenario.situation.trim().split(/\n\s*\n/);
const Title = as === 'page' ? 'h1' : 'h2';
const Takeaway = as === 'page' ? 'h2' : 'h3';
const scene = sceneFor(entry.id, scenario.set, scenario.category, scenario.scene);
---

<article class="quiz" data-scenario data-id={entry.id}>
  <header class="quiz-head">
    <p class="kicker">{label}</p>
    <Title class="quiz-title" tabindex="-1">{scenario.title}</Title>
  </header>

  {scenario.chat ? <Chat chat={scenario.chat} /> : <Scene spec={scene} seed={entry.id} />}

  <div class="prose situation">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <form data-quiz>
    <fieldset>
      <legend data-question={scenario.question}>{scenario.question}</legend>
      {
        scenario.options.map((option, index) => (
          <div class="opt" data-option data-call={option.call}>
            <label>
              <input type="radio" name={`answer-${slug}`} value={index} />
              <span>
                {option.text}
                <em class="yours" data-yours hidden>
                  Your call
                </em>
              </span>
            </label>
            <div class="why" data-why data-call={option.call} tabindex="-1">
              <b class="why-head">
                <span class="why-mark" aria-hidden="true">{calls[option.call].mark}</span>
                <span>{calls[option.call].label}</span>
                <small class="why-points" data-why-points hidden></small>
              </b>
              <p>{option.why}</p>
            </div>
          </div>
        ))
      }
    </fieldset>

    <p class="hint" data-hint role="alert" hidden>Pick the answer closest to what you would do.</p>
    <button class="btn block" data-check hidden>Make the call</button>
    <button type="button" class="btn ghost block" data-show-all hidden>Compare the other answers</button>
  </form>

  <p class="visually-hidden" data-verdict role="status"></p>

  <div data-after>
    <section class="principle">
      <Takeaway>Key takeaway</Takeaway>
      <p><mark class="hl">{scenario.principle}</mark></p>
    </section>
    <slot name="after" />
  </div>

  <button type="button" class="textbtn skip" data-skip hidden>Skip for now</button>
</article>
