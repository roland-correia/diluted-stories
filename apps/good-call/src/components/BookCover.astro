---
// A course's cover, drawn as a book: a gradient, soft light that drifts, a picture
// that floats gently and the title set like a book jacket. All of it is SVG, made
// here, so there are no image licences to worry about. The movement is switched off
// for people who ask their device for reduced motion (see global.css).
import { courses, type Motif } from '../lib/courses';
import { sets, type SetId } from '../lib/site';

interface Props {
  id: SetId;
  /** Draw a larger, sharper title for the book page. */
  large?: boolean;
  /** Hide the cover from screen readers, where the course's name is already written beside it. */
  decorative?: boolean;
  class?: string;
}

const { id, large = false, decorative = false, class: className } = Astro.props;
const { cover } = courses[id];
const name = sets[id].name;
// Ids inside the SVG must be unique on the page, as several covers can share one.
const uid = `${id}-${Math.random().toString(36).slice(2, 8)}`;

// Fit the longest line across the cover: 156 units wide, in bold capitals.
const longest = Math.max(...cover.lines.map((line) => line.length));
const size = Math.min(36, Math.floor(156 / (longest * 0.66)));
const titleTop = 46;
const titleBottom = titleTop + (cover.lines.length - 1) * size * 1.02;

// Each picture is drawn in a 100 x 100 box, in the cover's accent colour.
const a = cover.accent;
const motifs: Record<Motif, string> = {
  hearts: `<path d="M50 84C18 62 8 42 22 28c10-9 22-5 28 5 6-10 18-14 28-5 14 14 4 34-28 56z" fill="${a}" opacity="0.92"/>
    <path d="M71 40c-8-8-18-5-22 2" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity="0.55"/>`,
  circles: `<circle cx="37" cy="42" r="25" fill="#f1c9a5" opacity="0.92"/>
    <circle cx="63" cy="42" r="25" fill="#b07a4f" opacity="0.85"/>
    <circle cx="50" cy="64" r="25" fill="#6b4027" opacity="0.85"/>
    <circle cx="50" cy="50" r="40" fill="none" stroke="${a}" stroke-width="2.5" stroke-dasharray="4 6"/>`,
  moon: `<path d="M62 18a34 34 0 1 0 22 54A28 28 0 1 1 62 18z" fill="${a}"/>
    <path d="M24 22l2 5 5 2-5 2-2 5-2-5-5-2 5-2zM82 40l1.5 3.5 3.5 1.5-3.5 1.5L82 50l-1.5-3.5L77 45l3.5-1.5z" fill="#fff" opacity="0.85"/>`,
  rattle: `<circle cx="50" cy="34" r="22" fill="${a}"/>
    <circle cx="42" cy="28" r="3" fill="#fff" opacity="0.8"/><circle cx="56" cy="38" r="3" fill="#fff" opacity="0.8"/><circle cx="52" cy="24" r="2.5" fill="#fff" opacity="0.8"/>
    <rect x="46" y="54" width="8" height="26" rx="4" fill="${a}" opacity="0.9"/>
    <circle cx="50" cy="86" r="9" fill="none" stroke="${a}" stroke-width="5"/>`,
  blocks: `<rect x="14" y="54" width="34" height="34" rx="4" fill="${a}"/>
    <rect x="52" y="54" width="34" height="34" rx="4" fill="${a}" opacity="0.75"/>
    <rect x="33" y="16" width="34" height="34" rx="4" fill="${a}" opacity="0.9" transform="rotate(-8 50 33)"/>
    <path d="M24 78l7-16 7 16M28 72h7M63 62v16h6c4 0 6-2 6-4s-2-4-6-4h-6m0 0h5c3 0 5-2 5-4s-2-4-5-4h-5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/>`,
  kite: `<path d="M50 6l26 30-26 40-26-40z" fill="${a}"/>
    <path d="M50 6v70M24 36h52" stroke="#fff" stroke-width="2" opacity="0.6"/>
    <path d="M50 76c-6 6 6 10 0 16" fill="none" stroke="${a}" stroke-width="2.5"/>
    <path d="M44 84l6 2-6 2zM56 92l-6 2 6 2z" fill="${a}"/>`,
  pencil: `<path d="M16 80h68v8H16z" fill="${a}" opacity="0.55"/>
    <path d="M22 80c8-6 20-6 28 0 8-6 20-6 28 0" fill="none" stroke="${a}" stroke-width="3"/>
    <path d="M70 10l12 12-40 40-16 4 4-16z" fill="${a}"/>
    <path d="M30 50l12 12" stroke="#fff" stroke-width="2.4" opacity="0.6"/>`,
  headphones: `<path d="M18 62V50a32 32 0 0 1 64 0v12" fill="none" stroke="${a}" stroke-width="7" stroke-linecap="round"/>
    <rect x="10" y="56" width="18" height="30" rx="8" fill="${a}"/>
    <rect x="72" y="56" width="18" height="30" rx="8" fill="${a}"/>
    <path d="M46 40v20a6 6 0 1 1-4-5.6V36l14-4v18a6 6 0 1 1-4-5.6V38z" fill="#fff" opacity="0.85"/>`,
  house: `<path d="M14 48L50 16l36 32v40H14z" fill="${a}"/>
    <path d="M50 76C36 66 32 58 38 52c4-4 9-2 12 2 3-4 8-6 12-2 6 6 2 14-12 24z" fill="#fff" opacity="0.9"/>`,
  teacup: `<path d="M18 44h52v14c0 16-12 26-26 26S18 74 18 58z" fill="${a}"/>
    <path d="M70 50h6c8 0 8 16-2 16h-6" fill="none" stroke="${a}" stroke-width="5"/>
    <path d="M10 88h68" stroke="${a}" stroke-width="5" stroke-linecap="round"/>
    <path d="M34 34c-4-6 4-10 0-18M48 34c-4-6 4-10 0-18" fill="none" stroke="${a}" stroke-width="3" stroke-linecap="round" opacity="0.8"/>`,
  bubbles: `<path d="M8 22c0-8 6-12 14-12h34c8 0 14 4 14 12v20c0 8-6 12-14 12H30l-14 12V54c-6-2-8-6-8-12z" fill="${a}"/>
    <path d="M36 24c0-5 10-5 10 0 0 4-5 4-5 9M41 39v1" fill="none" stroke="#1b1b1b" stroke-width="3.2" stroke-linecap="round" opacity="0.75"/>
    <path d="M92 52c0-8-6-12-14-12H54c-8 0-14 4-14 12v14c0 8 6 12 14 12h14l12 10V76c8-2 12-6 12-12z" fill="#fff" opacity="0.85"/>
    <path d="M66 50v12M66 69v1" stroke="#1b1b1b" stroke-width="3.6" stroke-linecap="round" opacity="0.75"/>`,
  calendar: `<rect x="14" y="20" width="72" height="66" rx="8" fill="${a}"/>
    <rect x="14" y="20" width="72" height="16" rx="8" fill="#fff" opacity="0.35"/>
    <path d="M30 12v16M70 12v16" stroke="${a}" stroke-width="6" stroke-linecap="round"/>
    <path d="M34 60l10 10 22-22" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>`,
  headset: `<path d="M18 58V48a32 32 0 0 1 64 0v10" fill="none" stroke="${a}" stroke-width="7" stroke-linecap="round"/>
    <rect x="10" y="50" width="16" height="26" rx="7" fill="${a}"/>
    <rect x="74" y="50" width="16" height="26" rx="7" fill="${a}"/>
    <path d="M18 76c0 12 10 16 24 16" fill="none" stroke="${a}" stroke-width="4" stroke-linecap="round"/>
    <rect x="40" y="86" width="14" height="10" rx="5" fill="${a}"/>`,
  care: `<path d="M50 86C18 64 8 44 22 30c10-9 22-5 28 5 6-10 18-14 28-5 14 14 4 34-28 56z" fill="${a}"/>
    <path d="M50 40v26M37 53h26" stroke="#fff" stroke-width="7" stroke-linecap="round" opacity="0.9"/>`,
  heartcheck: `<path d="M50 86C18 64 8 44 22 30c10-9 22-5 28 5 6-10 18-14 28-5 14 14 4 34-28 56z" fill="none" stroke="${a}" stroke-width="6" stroke-linejoin="round"/>
    <path d="M36 52l10 10 20-20" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>`,
  phone: `<rect x="28" y="12" width="44" height="78" rx="9" fill="none" stroke="${a}" stroke-width="5"/>
    <path d="M40 34h24a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H50l-7 6v-6h-3a5 5 0 0 1-5-5V39a5 5 0 0 1 5-5z" fill="#fff" opacity="0.9"/>
    <path d="M52 48c-5-3.5-7-6-5-8.5 1.6-1.9 4.1-1 5 0.8 0.9-1.8 3.4-2.7 5-0.8 2 2.5 0 5-5 8.5z" fill="${a}"/>
    <circle cx="50" cy="80" r="3" fill="${a}"/>`,
  flag: `<path d="M6 90l30-44 16 20 12-14 30 38z" fill="${a}" opacity="0.8"/>
    <path d="M52 66V14" stroke="${a}" stroke-width="4" stroke-linecap="round"/>
    <path d="M52 16h30l-8 9 8 9H52z" fill="#fff" opacity="0.9"/>`,
};
---

<svg
  class:list={['cover', { 'cover-large': large }, className]}
  viewBox="0 0 200 300"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : `Cover of ${name}`}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <defs>
    <linearGradient id={`bg-${uid}`} x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color={cover.from}></stop>
      <stop offset="1" stop-color={cover.to}></stop>
    </linearGradient>
    <radialGradient id={`glow-${uid}`}>
      <stop offset="0" stop-color={cover.accent} stop-opacity="0.38"></stop>
      <stop offset="1" stop-color={cover.accent} stop-opacity="0"></stop>
    </radialGradient>
    <clipPath id={`clip-${uid}`}><rect width="200" height="300" rx="9"></rect></clipPath>
  </defs>

  <g clip-path={`url(#clip-${uid})`}>
    <rect width="200" height="300" fill={`url(#bg-${uid})`}></rect>
    <g class="cover-light">
      <circle cx="160" cy="80" r="90" fill={`url(#glow-${uid})`}></circle>
      <circle cx="30" cy="250" r="100" fill={`url(#glow-${uid})`}></circle>
    </g>

    <text class="cover-title" x="22" y={titleTop} font-size={size}>
      {cover.lines.map((line, i) => <tspan x="22" dy={i === 0 ? 0 : size * 1.02}>{line}</tspan>)}
    </text>
    {cover.sub && <text class="cover-sub" x="23" y={titleBottom + 24} fill={cover.accent}>{cover.sub}</text>}

    <g transform={`translate(42 ${Math.max(118, titleBottom + 42)}) scale(1.16)`}>
      <g class="cover-motif" set:html={motifs[cover.motif]} />
    </g>

    <g transform="translate(22 270)">
      <path
        d="M4.5 2.5h7a2.5 2.5 0 0 1 2.5 2.5v4a2.5 2.5 0 0 1-2.5 2.5H7L4.5 14v-2.5A2.5 2.5 0 0 1 2 9V5a2.5 2.5 0 0 1 2.5-2.5z"
        fill="none"
        stroke={cover.accent}
        stroke-width="1.4"></path>
      <path d="M5.3 7.1l1.9 1.9 3.6-3.6" fill="none" stroke={cover.accent} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <text class="cover-brand" x="20" y="11.5" fill={cover.accent}>GOOD CALL</text>
    </g>

    <!-- The spine: a shadow and a highlight down the left edge, like a real book. -->
    <rect width="9" height="300" fill="#000" opacity="0.28"></rect>
    <rect x="9" width="1.4" height="300" fill="#fff" opacity="0.14"></rect>
  </g>
</svg>
