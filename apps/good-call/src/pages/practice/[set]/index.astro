---
// The reader: a course as one continuous deck of cards, every question in it,
// topic after topic, one card at a time, like the pages of a story. It opens on
// the first unanswered card. The bar across the top has one segment per topic.
// After the last card, a summary shows the results, the coins earned and the
// item unlocked, and leads on to the next book.
// src/scripts/deck.ts runs the deck, src/scripts/scenario.ts each question on it,
// src/scripts/listen.ts the Listen button and src/scripts/cast.ts puts the
// visitor's character into each scenario.
// Without JavaScript every card is shown in order, as a worked example.
import Base from '../../../layouts/Base.astro';
import Support from '../../../components/Support.astro';
import QuizCard from '../../../components/QuizCard.astro';
import { getLiveSets, sectionsOf, type Scenario, type Section } from '../../../lib/scenarios';
import { sets, type SetId } from '../../../lib/site';
import { courses, accessories } from '../../../lib/courses';
import { photoOf } from '../../../lib/photos';
import { href } from '../../../lib/paths';

export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.map(({ id, scenarios }) => {
    // The next course on the same shelf (relationships, parenting or work), if there is one.
    const siblings = liveSets.filter((other) => sets[other.id].group === sets[id].group);
    const next = siblings[siblings.findIndex((other) => other.id === id) + 1];
    return { params: { set: id }, props: { id, scenarios, nextId: next?.id } };
  });
}

const { id, scenarios, nextId } = Astro.props as { id: SetId; scenarios: Scenario[]; nextId?: SetId };
const set = sets[id] as Extract<(typeof sets)[SetId], { live: true }>;
const course = courses[id];
const isWork = set.group === 'work';
const sectioned = sectionsOf(id, scenarios);
// A course without topics is treated as one topic named after the course.
const topics: Section[] = sectioned.length > 0 ? sectioned : [{ id: id, name: set.name, blurb: set.blurb, scenarios }];
// The deck runs through the topics in order.
const cards = topics.flatMap((topic) => topic.scenarios.map((entry) => ({ entry, topic })));
const indexOf = (entry: Scenario) => cards.findIndex((card) => card.entry === entry);
const count = (n: number) => `${n} ${n === 1 ? 'question' : 'questions'}`;
const bookPath = href(`/courses/${id}/`);
const next = nextId ? { name: sets[nextId].name, path: href(`/courses/${nextId}/`) } : undefined;
---

<Base title={`Reading: ${set.name}`} description={set.intro} path={`/practice/${id}/`} chrome="bare">
  <div class="reader">
    <div class="deck" data-deck data-set={id}>
      <header class="reader-top">
        <div class="reader-bar">
          <a class="iconbtn round" href={bookPath} aria-label={`Close, and go back to ${set.name}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </a>
          <h1>{set.name}</h1>
          <button type="button" class="iconbtn round" data-open-settings aria-haspopup="dialog" aria-label="Reading settings">Aa</button>
        </div>
        <ol class="deck-segs" aria-hidden="true">
          {
            topics.map((topic) => (
              <li data-seg data-ids={topic.scenarios.map((s) => s.id).join(',')} title={topic.name}>
                <i data-seg-fill />
              </li>
            ))
          }
        </ol>
        <p class="deck-count" data-deck-count aria-live="polite">{count(scenarios.length)}</p>
      </header>

      <div class="deck-stage" data-deck-stage>
        {
          cards.map(({ entry, topic }, index) => (
            <section
              class="deck-card"
              id={`card-${index + 1}`}
              data-slide
              data-topic={topic.id}
              aria-label={`${topic.name}. Card ${index + 1} of ${cards.length}`}
            >
              <QuizCard entry={entry} label={topic.name} photo={photoOf(id, topic.id)} />
            </section>
          ))
        }

        <section class="deck-card deck-done" id="done" data-slide data-summary aria-labelledby="done-title">
          <div class="done-badge" data-done-badge aria-hidden="true" hidden>
            <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          </div>
          <p class="kicker" data-done-kicker>Your progress</p>
          <h2 id="done-title" tabindex="-1">{set.name}</h2>
          <p class="done-score" data-done-score></p>
          <div class="done-reward" data-done-reward>
            <span data-reward-coins>0 coins earned</span>
            {course.unlock && <span data-reward-item hidden>Unlocked: {accessories[course.unlock].name}</span>}
          </div>

          {
            topics.map((topic) => (
              <section class="done-group" aria-label={topic.name}>
                <h3>{topic.name}</h3>
                <ol class="done-list">
                  {topic.scenarios.map((entry) => (
                    <li>
                      <a href={`#card-${indexOf(entry) + 1}`} data-goto={indexOf(entry)}>
                        <span class="done-mark" data-done-mark data-id={entry.id} aria-hidden="true" />
                        <span>
                          <b>{entry.data.title}</b>
                          <small data-done-verdict data-id={entry.id}>
                            Not answered yet
                          </small>
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            ))
          }

          <section class="done-rules" aria-labelledby="rules-title">
            <h3 id="rules-title">{isWork ? 'What employers look for' : 'Key principles'}</h3>
            <ul class="ticks">
              {set.rules.map((rule) => <li>{rule}</li>)}
            </ul>
          </section>

          <button type="button" class="btn block" data-resume hidden>Continue where you left off</button>
          {
            next && (
              <a class="btn block" href={next.path} data-next-module>
                Next book: {next.name}
              </a>
            )
          }
          <a class="btn ghost block" href={`${bookPath}#give`}>Give your coins to a charity</a>
          <a class="btn ghost block" href={bookPath}>Back to the course</a>
          <button type="button" class="textbtn done-reset" data-deck-reset>Clear my answers and start again</button>
        </section>
      </div>

      <nav class="deck-nav" data-deck-nav aria-label="Cards" hidden>
        <div class="deck-nav-inner">
          <button type="button" class="round-btn" data-prev aria-label="Previous card">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <button type="button" class="round-btn" data-next aria-label="Next card">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
          <span class="next-label" data-next-label aria-hidden="true"></span>
          <button type="button" class="round-btn listen" data-listen aria-pressed="false" aria-label="Listen to this card" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="play" d="M8 5.5v13l10.5-6.5z"></path>
              <path class="stop" d="M8 6v12M16 6v12"></path>
            </svg>
          </button>
        </div>
      </nav>
    </div>

    <Support set={id} />
    <p class="fine" style="padding-bottom: 7rem">
      For education only. It is not legal or professional advice. <a href={href('/about/#disclaimer')}>Read the full disclaimer</a>
    </p>
  </div>

  <script>
    import '../../../scripts/scenario.ts';
    import '../../../scripts/deck.ts';
    import '../../../scripts/cast.ts';
    import '../../../scripts/listen.ts';
  </script>
</Base>
