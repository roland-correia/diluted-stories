---
// Topics used to have pages of their own. Each course is now one reader, so these
// addresses send people to the intro of that module in its course's reader.
import { getLiveSets, sectionsOf } from '../../../../lib/scenarios';
import { href } from '../../../../lib/paths';

export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.flatMap(({ id, scenarios }) => {
    const topics = sectionsOf(id, scenarios);
    return topics.map((topic) => ({
      params: { set: id, topic: topic.id },
      props: { target: `${href(`/practice/${id}/`)}#step=intro-${topic.id}` },
    }));
  });
}

// A permanent redirect, so the browser moves on straight away.
return Astro.redirect((Astro.props as { target: string }).target, 301);
---
