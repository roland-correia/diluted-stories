---
// Home: every course as a book, on three shelves. Parenting courses are listed by
// age right here, with nothing to click through first. Above the shelves:
// - today's goal, five questions (src/scripts/books.ts),
// - "Did you try it?", asking about a habit planned on an earlier day (src/scripts/habits.ts),
// - a card leading straight back into the course the visitor was last reading, with
//   its progress module by module and the next module named (src/scripts/books.ts).
import Base from '../layouts/Base.astro';
import Book from '../components/Book.astro';
import BookCover from '../components/BookCover.astro';
import { getLiveSets, sectionsOf } from '../lib/scenarios';
import { sets, groups, type SetId } from '../lib/site';
import { href } from '../lib/paths';
import { DAILY_GOAL } from '../lib/game';

const liveSets = await getLiveSets();
const all = Object.keys(sets) as SetId[];
const shelf = (group: keyof typeof groups) => all.filter((id) => sets[id].group === group);
const shelves = [
  { id: 'everyday', name: groups.everyday.name, books: shelf('everyday') },
  { id: 'parenting', name: 'Parenting, age by age', books: shelf('parenting') },
  { id: 'work', name: groups.work.name, books: shelf('work') },
];
---

<Base title="Good Call" path="/" tab="home">
  <div class="hello">
    <span class="avatar-slot" data-avatar aria-hidden="true"></span>
    <div class="hello-text">
      <h1 data-hello>Welcome to Good Call</h1>
      <a class="today" href={href('/profile/#stats')} data-today hidden>
        <span class="today-ring" data-today-ring aria-hidden="true">
          <svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="18"></circle><circle class="fill" cx="22" cy="22" r="18" pathLength="100"></circle></svg>
        </span>
        <span><b data-today-count>0 of {DAILY_GOAL}</b> <small>today</small></span>
      </a>
    </div>
  </div>

  <section class="checkin" aria-labelledby="checkin-title" data-checkin hidden>
    <p class="kicker" id="checkin-title">Did you try it?</p>
    <p class="checkin-habit"><b data-checkin-name></b></p>
    <p class="checkin-cue">Your plan: <span data-checkin-cue></span></p>
    <div class="checkin-ask" data-checkin-ask>
      <button type="button" class="btn" data-checkin-done>I did it</button>
      <button type="button" class="btn ghost" data-checkin-later>Not yet</button>
      <button type="button" class="textbtn" data-checkin-skip>Not for me</button>
    </div>
    <p class="checkin-thanks" data-checkin-thanks tabindex="-1" role="status" hidden></p>
  </section>

  <section class="group" aria-labelledby="continue-title" data-continue-section hidden>
    <h2 id="continue-title">Continue learning</h2>
    {
      liveSets.map(({ id, scenarios }) => {
        const modules = sectionsOf(id, scenarios);
        const parts = modules.length > 0 ? modules : [{ id, name: sets[id].name, scenarios }];
        return (
          <a class="continue" href={href(`/practice/${id}/`)} data-continue={id} hidden>
            <BookCover id={id} decorative />
            <span>
              <b>{sets[id].name}</b>
              <small data-continue-detail />
              <span class="mod-progress">
                <ol class="mod-bar" aria-hidden="true">
                  {parts.map((part) => (
                    <li data-mod-ids={part.scenarios.map((s) => s.id).join(',')} data-mod-name={part.name}>
                      <i />
                    </li>
                  ))}
                </ol>
                <span data-continue-percent>0%</span>
              </span>
            </span>
          </a>
        );
      })
    }
  </section>

  {
    shelves.map((group) => (
      <section class="shelf" id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="shelf-head">
          <h2 id={`${group.id}-title`}>{group.name}</h2>
        </div>
        <ul class="shelf-row">
          {group.books.map((id) => (
            <li>
              <Book id={id} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <a class="btn ghost block" href={href('/explore/')}>Search every course</a>

  <script>
    import '../scripts/books.ts';
    import '../scripts/habits.ts';
  </script>
</Base>
