---
// Rendered once, by Base.astro, at the end of every page. Gives the site a
// consistent way back to its own home and topics, instead of each page
// improvising its own ad-hoc "More in Tech"-style link.
import Wordmark from './Wordmark.astro';
import { href } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <a class="wm-link" href={href('/')} aria-label="Diluted Stories home">
    <Wordmark />
  </a>
  <p class="footer-lead">
    Good research shouldn't sit behind a paywall. We take well-researched work and explain it plainly, with every source linked so you can check it yourself.
  </p>
  <nav class="footer-nav" aria-label="Diluted Stories">
    <a href={href('/')}>Home</a>
    <a href={href('/topics/')}>Topics</a>
  </nav>
  <p class="footer-fine">
    © {year} Diluted Stories. <a href="#" data-email data-user="info" data-domain="dilutedstories.com">info [at] dilutedstories [dot] com</a>
  </p>
</footer>

<script>
  // The address is put together here instead of being written as
  // mailto:user@domain in the HTML, which keeps it away from bots that scan
  // raw HTML for "@". Without JavaScript the readable "[at]" form stays on
  // the page. This stops mass harvesting, not a determined reader.
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((link) => {
    const address = `${link.dataset.user}@${link.dataset.domain}`;
    link.href = `mailto:${address}`;
    link.textContent = address;
  });
</script>
