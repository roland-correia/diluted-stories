---
// Rendered once, by Base.astro, at the end of every page.
import Wordmark from './Wordmark.astro';
import EmailLink from './EmailLink.astro';
import { contact, nav } from '../lib/site';
import { href } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <a class="wm-link" href={href('/')} aria-label="Diluted Stories home">
    <Wordmark />
  </a>
  <p class="footer-lead">Marketing, social media ads and websites for growing businesses.</p>
  <nav class="footer-nav" aria-label="Footer">
    <a href={href('/')}>Home</a>
    {nav.map((item) => <a href={href(item.path)}>{item.label}</a>)}
  </nav>
  <p class="footer-contact">
    <EmailLink /><br />
    <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
  </p>
  <p class="footer-fine">© {year} Diluted Stories</p>
</footer>
