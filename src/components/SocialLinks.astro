---
// Icon links to the social profiles listed in src/lib/site.ts. Icon-only by
// default (footer); pass `labels` to show the name next to each icon.
import { socials } from '../lib/site';

interface Props {
  labels?: boolean;
}

const { labels = false } = Astro.props;
---

<ul class="socials">
  {
    socials.map((social) => (
      <li>
        <a
          class="iconbtn"
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={labels ? `${social.name} (opens in a new tab)` : `Diluted Stories on ${social.name} (opens in a new tab)`}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {social.icon === 'linkedin' && (
              <>
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <path d="M8 10.5V16" />
                <path d="M11.5 16v-5.5" />
                <path d="M11.5 12.8c0-1.4 1-2.3 2.3-2.3 1.4 0 2.2.9 2.2 2.4V16" />
                <circle cx="8" cy="7.7" r="0.9" fill="currentColor" stroke="none" />
              </>
            )}
            {social.icon === 'github' && (
              <>
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
              </>
            )}
            {social.icon === 'instagram' && (
              <>
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none" />
              </>
            )}
          </svg>
          {labels && <span>{social.name}</span>}
        </a>
      </li>
    ))
  }
</ul>
