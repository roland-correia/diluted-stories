---
import '@fontsource-variable/lexend';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import SettingsDialog from '../components/SettingsDialog.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, DESCRIPTION, nav } from '../lib/site';
import { href, absolute } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** The page's own path, e.g. '/services/', used for the canonical and share URLs and the current nav link. */
  path: string;
  type?: 'website' | 'article';
}

const { title, description = DESCRIPTION, path, type = 'website' } = Astro.props;
const pageTitle = path === '/' ? `${SITE_NAME}: marketing, social media ads and websites` : `${title} | ${SITE_NAME}`;
const canonical = absolute(path);
---

<!doctype html>
<html lang="en-GB" data-size="md" data-space="normal" data-bg="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" href={href('/icon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('/og-default.png')} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Runs before the page paints, so saved reading settings never flash the default look. -->
    <script is:inline>
      try {
        var saved = JSON.parse(localStorage.getItem('ds-settings') || '{}');
        var allowed = {
          size: ['sm', 'md', 'lg'],
          space: ['normal', 'roomy'],
          bg: ['auto', 'soft', 'cream', 'dark'],
        };
        for (var key in allowed) {
          if (allowed[key].indexOf(saved[key]) > -1) {
            document.documentElement.setAttribute('data-' + key, saved[key]);
          }
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="bar">
        <a class="wm-link" href={href('/')} aria-label="Diluted Stories home">
          <Wordmark />
        </a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={href(item.path)} aria-current={path.startsWith(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="bar-tools">
          <button type="button" class="iconbtn" data-open-settings aria-haspopup="dialog" aria-label="Reading settings">Aa</button>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <SettingsDialog />
    <script>
      import '../scripts/settings.ts';
    </script>
  </body>
</html>
