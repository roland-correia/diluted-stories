---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { services, steps } from '../data/services';
import { products } from '../data/products';
import { getPosts, readMinutes, formatDate } from '../lib/posts';
import { href } from '../lib/paths';

const latest = (await getPosts()).slice(0, 3);
---

<Base title="Diluted Stories" path="/">
  <section class="hero">
    <p class="kicker">Business consultancy</p>
    <h1 class="focus">
      {services.map((service) => <span>{service.name}</span>)}
    </h1>
    <p class="lead">We run your campaigns and ads, and build the website they send people to.</p>
    <div class="actions">
      <a class="btn" href={href('/contact/')}>Get in touch</a>
      <a class="btn ghost" href={href('/services/')}>Our services</a>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <h2 id="services-title">What we do</h2>
    <div class="grid three">
      {
        services.map((service) => (
          <a class="card link" href={href(`/services/#${service.id}`)}>
            <h3>{service.name}</h3>
            <p>{service.short}</p>
            <span class="more" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <h2 id="how-title">How we work</h2>
    <ol class="grid three steps">
      {
        steps.map((step) => (
          <li class="card">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="dev-title">
    <p class="kicker">Under development</p>
    <h2 id="dev-title">Our products</h2>
    <div class="grid two">
      {
        products.map((product) => (
          <a class="card link" href={href(product.path)}>
            <h3>{product.name}</h3>
            <p>{product.blurb}</p>
            <span class="more" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section" aria-labelledby="blog-title">
        <h2 id="blog-title">From the blog</h2>
        <div class="grid three">
          {latest.map((post) => (
            <a class="card link" href={href(`/blog/${post.id}/`)}>
              <h3>{post.data.title}</h3>
              <p class="meta">
                {formatDate(post.data.publishedAt)} · {readMinutes(post)} min read
              </p>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
        <a class="textbtn" href={href('/blog/')}>All posts</a>
      </section>
    )
  }

  <ContactCta />
</Base>
