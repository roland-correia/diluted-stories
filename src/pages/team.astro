---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { team } from '../data/team';
import { href } from '../lib/paths';
---

<Base title="Team" description="The people who run Diluted Stories." path="/team/">
  <section class="hero">
    <p class="kicker">Team</p>
    <h1>The people behind Diluted Stories</h1>
  </section>

  <section class="grid three top" aria-label="Team members">
    {
      team.map((person) => (
        <article class="card person">
          {person.photo ? (
            <img class="avatar" src={href(person.photo.src)} alt={person.photo.alt} width="800" height="1067" loading="lazy" decoding="async" />
          ) : (
            <span class="avatar" aria-hidden="true">{person.placeholder ? '?' : person.name.charAt(0)}</span>
          )}
          {person.placeholder && <span class="chip">Placeholder</span>}
          <h2>{person.name}</h2>
          <p class="kicker">{person.role}</p>
          <p>{person.bio}</p>
        </article>
      ))
    }
  </section>

  <ContactCta />
</Base>
